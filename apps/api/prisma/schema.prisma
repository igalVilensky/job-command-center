generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  candidateProfile CandidateProfile?
  jobSources       JobSource[]
  jobs             Job[]
  automationRuns   AutomationRun[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model CandidateProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRoles           String[] @default([])
  strongSkills          String[] @default([])
  secondarySkills       String[] @default([])
  avoidSkills           String[] @default([])
  mixedSkills           String[] @default([])
  minimumSalaryEur      Int?
  preferredLocations    String[] @default([])
  remotePreference      String?
  germanLevel           String?
  englishLevel          String?
  seniorityNotes        String?
  industryPreferences   String[] @default([])
  industryAvoid         String[] @default([])
  availabilityDate      DateTime?
  profileNotes          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model JobSource {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType   String
  sourceName   String?
  externalId   String?
  metadataJson Json?
  jobs         Job[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Job {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId         String?
  source           JobSource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  description      JobDescription?
  aiReviews        AiReview[]
  automationRuns   AutomationRun[]
  externalSourceId String?
  company          String
  title            String
  location         String?
  remoteType       String          @default("unknown")
  salaryMinEur     Int?
  salaryMaxEur     Int?
  salaryText       String?
  url              String?
  sourceQuality    String          @default("unknown")
  status           String          @default("imported")
  importedAt       DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  archivedAt       DateTime?

  @@index([userId, archivedAt])
  @@index([userId, status])
  @@index([sourceId])
}

model JobDescription {
  id            String   @id @default(cuid())
  jobId         String   @unique
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  summaryText   String?
  fullText      String?
  rawSourceText String?
  language      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AiReview {
  id                     String   @id @default(cuid())
  jobId                  String
  job                    Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider               String
  model                  String
  promptVersion          String
  score                  Int
  decision               String
  reviewText             String
  riskFlags              String[] @default([])
  cvAngle                String
  clarificationQuestions String[] @default([])
  rawResponseJson        Json?
  createdAt              DateTime @default(now())

  @@index([jobId, createdAt])
}

model AutomationRun {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId         String?
  job           Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  runType       String
  provider      String?
  model         String?
  status        String
  inputChars    Int?
  errorMessage  String?
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  metadataJson  Json?

  @@index([userId, startedAt])
  @@index([jobId])
}
