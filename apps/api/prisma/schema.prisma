generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  candidateProfile CandidateProfile?
  candidateCvs     CandidateCv[]
  jobSources       JobSource[]
  jobs             Job[]
  importedEmails   ImportedEmail[]
  emailAccounts    EmailAccount[]
  automationRuns   AutomationRun[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model CandidateProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profession            String?
  bio                   String?  @db.Text
  targetRoles           String[] @default([])
  strongSkills          String[] @default([])
  secondarySkills       String[] @default([])
  engineeringSkills     String[] @default([])
  aiSkills              String[] @default([])
  avoidSkills           String[] @default([])
  mixedSkills           String[] @default([])
  minimumSalaryEur      Int?
  salaryMinEur          Int?
  salaryMaxEur          Int?
  preferredLocations    String[] @default([])
  remotePreference      String?
  acceptableRemoteTypes String[] @default([])
  locationNotes         String?
  salaryNotes           String?
  germanLevel           String?
  englishLevel          String?
  languagesJson         Json?
  experienceSummary     String?  @db.Text
  profileSourceId       String?
  seniorityNotes        String?
  industryPreferences   String[] @default([])
  industryAvoid         String[] @default([])
  availabilityDate      DateTime?
  profileNotes          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model CandidateCv {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType        String   @default("typst")
  sourceName        String?
  sourceText        String   @db.Text
  parsedProfileJson Json?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, isActive])
}

model JobSource {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType   String
  sourceName   String?
  externalId   String?
  metadataJson Json?
  jobs         Job[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Job {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId          String?
  source            JobSource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  importedEmailId   String?
  importedEmail     ImportedEmail?  @relation(fields: [importedEmailId], references: [id], onDelete: SetNull)
  description       JobDescription?
  aiReviews         AiReview[]
  automationRuns    AutomationRun[]
  externalSourceId  String?
  company           String
  title             String
  location          String?
  remoteType        String          @default("unknown")
  salaryMinEur      Int?
  salaryMaxEur      Int?
  salaryText        String?
  url               String?
  sourceQuality     String          @default("unknown")
  status            String          @default("imported")
  userDecision      String?         @default("undecided")
  applicationStatus String?         @default("not_started")
  userNotes         String?
  nextAction        String?
  followUpDate      DateTime?
  appliedAt         DateTime?
  rejectedAt        DateTime?
  importedAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  archivedAt        DateTime?

  @@index([userId, archivedAt])
  @@index([userId, status])
  @@index([userId, applicationStatus])
  @@index([userId, userDecision])
  @@index([sourceId])
  @@index([importedEmailId])
}

model JobDescription {
  id            String   @id @default(cuid())
  jobId         String   @unique
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  summaryText   String?
  fullText      String?
  rawSourceText String?
  language      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ImportedEmail {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String   @default("gmail")
  providerMessageId String
  providerThreadId  String?
  fromEmail         String?
  fromName          String?
  subject           String
  receivedAt        DateTime?
  sourceLabel       String?
  snippet           String?
  bodyText          String?  @db.Text
  rawMetadataJson   Json?
  importStatus      String   @default("imported")
  extractionStatus  String   @default("not_started")
  inboxStatus       String   @default("active")
  processedAt       DateTime?
  hiddenAt          DateTime?
  triageReason      String?  @db.Text
  prefilterDecision String?
  jobLikelihoodScore Int?
  prefilterJson     Json?
  lastProcessedAt   DateTime?
  jobCount          Int      @default(0)
  errorMessage      String?  @db.Text
  jobs              Job[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, provider, providerMessageId])
  @@index([userId, receivedAt])
  @@index([userId, importStatus])
  @@index([userId, extractionStatus])
  @@index([userId, inboxStatus])
  @@index([userId, prefilterDecision])
}

model EmailAccount {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              String   @default("gmail")
  emailAddress          String?
  displayName           String?
  accessTokenEncrypted  String?  @db.Text
  refreshTokenEncrypted String?  @db.Text
  tokenExpiresAt        DateTime?
  scopes                String[] @default([])
  status                String   @default("connected")
  lastSyncAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, provider, emailAddress])
  @@index([userId, provider])
  @@index([status])
}

model AiReview {
  id                     String   @id @default(cuid())
  jobId                  String
  job                    Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider               String
  model                  String
  promptVersion          String
  score                  Int
  decision               String
  reviewText             String
  riskFlags              String[] @default([])
  cvAngle                String
  clarificationQuestions String[] @default([])
  fitBreakdownJson       Json?
  rawResponseJson        Json?
  createdAt              DateTime @default(now())

  @@index([jobId, createdAt])
}

model AutomationRun {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId         String?
  job           Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  runType       String
  provider      String?
  model         String?
  status        String
  inputChars    Int?
  errorMessage  String?
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  metadataJson  Json?

  @@index([userId, startedAt])
  @@index([jobId])
}
